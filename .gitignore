# Build
dist/
node_modules/

# Re-include the vendored agex-ts dists. The `dist/` rule above
# matches recursively, but vendor/agex-ts/<pkg>/dist holds the
# committed build artifacts the deploy depends on (see
# vendor/agex-ts/README.md).
!vendor/agex-ts/*/dist/
!vendor/agex-ts/*/dist/**

# Dev tooling
.vscode/
.idea/
.vite/
coverage/

# OS
.DS_Store

# Python
__pycache__/

# Environment / secrets
.env
.envrc

# Pyodide local dist (downloaded at dev time)
pyodide/

# Local wheels for dev iteration against unreleased agex/kvgit/termish
public/wheels/
