{
  "manifest_version": 3,
  "name": "Agex Site Filters",
  "description": "An agent that writes a filter for each site you submit a page from, hiding the clutter and native ads lists miss.",
  "version": "0.1.0",
  "minimum_chrome_version": "125",
  "permissions": [
    "activeTab",
    "declarativeNetRequest",
    "notifications",
    "offscreen",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Filter this site",
    "default_popup": "popup.html"
  },
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "options_ui": {
    "page": "app/app.html",
    "open_in_tab": true
  }
}
