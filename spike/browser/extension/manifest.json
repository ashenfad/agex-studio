{
  "manifest_version": 3,
  "name": "agex tabs spike",
  "version": "0.0.1",
  "key": "",
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:4173/*"
    ]
  }
}
